# Blade templates and test fixtures are compared byte-for-byte by the tests:
# keep them LF on every OS (core.autocrlf would otherwise turn them into CRLF).
*.blade.php text eol=lf
tests/Fixtures/** text eol=lf

# Maintainer-only files: keep them in the repo, out of the Composer dist
# archive (so they don't ship into every app's vendor/laravelopenpackages/laravel-optimized).
ReleaseWorkflow.md export-ignore
phpstan.neon export-ignore
phpunit.xml export-ignore
tests/ export-ignore
.github/ export-ignore
